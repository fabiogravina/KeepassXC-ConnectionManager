<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Kxc.App.ViewModels"
             xmlns:res="using:Kxc.App.Resources"
             x:Class="Kxc.App.Views.FirstRunView"
             x:DataType="vm:FirstRunViewModel">
  <DockPanel>
    <ScrollViewer>
      <StackPanel MaxWidth="460" Margin="24,40" HorizontalAlignment="Center" Spacing="16">
        <TextBlock Text="{x:Static res:Strings.FirstRun_Title}" FontSize="32" FontWeight="Bold" />
        <TextBlock Text="{x:Static res:Strings.FirstRun_Subtitle}" Classes="muted" FontSize="16" TextWrapping="Wrap" />

        <Button x:Name="ChooseButton" Classes="primary" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                Padding="16,14" Margin="0,16,0,8" Command="{Binding ChooseDatabaseCommand}"
                AutomationProperties.Name="{x:Static res:Strings.FirstRun_Choose}">
          <StackPanel Orientation="Horizontal" Spacing="10">
            <PathIcon Data="{StaticResource IconFolder}" Width="18" Height="18" Foreground="{DynamicResource KxcOnAccent}" />
            <TextBlock Text="{x:Static res:Strings.FirstRun_Choose}" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource KxcOnAccent}" />
          </StackPanel>
        </Button>

        <Border Background="{DynamicResource KxcPane}" BorderBrush="{DynamicResource KxcBorder}" BorderThickness="1" CornerRadius="12" Padding="20">
          <StackPanel Spacing="12">
            <StackPanel Spacing="2">
              <TextBlock Text="{x:Static res:Strings.FirstRun_NoDbTitle}" FontWeight="SemiBold" FontSize="15" />
              <TextBlock Text="{x:Static res:Strings.FirstRun_NoDbSubtitle}" Classes="muted" />
            </StackPanel>
            <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,Auto" RowSpacing="10" ColumnSpacing="12">
              <Border Width="26" Height="26" CornerRadius="13" Background="{DynamicResource KxcAccentSoft}" VerticalAlignment="Top">
                <TextBlock Text="1" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource KxcAccentText}" FontWeight="SemiBold" />
              </Border>
              <TextBlock Grid.Column="1" Text="{x:Static res:Strings.FirstRun_Step1}" TextWrapping="Wrap" />
              <Border Grid.Row="1" Width="26" Height="26" CornerRadius="13" Background="{DynamicResource KxcAccentSoft}" VerticalAlignment="Top">
                <TextBlock Text="2" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource KxcAccentText}" FontWeight="SemiBold" />
              </Border>
              <TextBlock Grid.Row="1" Grid.Column="1" Text="{x:Static res:Strings.FirstRun_Step2}" TextWrapping="Wrap" />
              <Border Grid.Row="2" Width="26" Height="26" CornerRadius="13" Background="{DynamicResource KxcAccentSoft}" VerticalAlignment="Top">
                <TextBlock Text="3" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource KxcAccentText}" FontWeight="SemiBold" />
              </Border>
              <TextBlock Grid.Row="2" Grid.Column="1" Text="{x:Static res:Strings.FirstRun_Step3}" TextWrapping="Wrap" />
            </Grid>
          </StackPanel>
        </Border>
      </StackPanel>
    </ScrollViewer>
  </DockPanel>
</UserControl>
