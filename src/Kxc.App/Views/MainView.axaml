<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Kxc.App.ViewModels"
             xmlns:res="using:Kxc.App.Resources"
             x:Class="Kxc.App.Views.MainView"
             x:DataType="vm:MainViewModel"
             x:Name="Root">
  <DockPanel>
    <!--
      Una sola barra sotto quella del titolo (decisione del 22 ottobre 2026): database, ricerca sempre a
      fuoco, Blocca, Impostazioni. Il blocco del database è largo quanto la colonna dei filtri.
    -->
    <Border DockPanel.Dock="Top" Padding="0,12,16,12" BorderBrush="{DynamicResource KxcBorder}" BorderThickness="0,0,0,1">
      <Grid ColumnDefinitions="220,*,Auto,Auto" ColumnSpacing="10">
        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10" Margin="16,0,6,0" VerticalAlignment="Center"
              ToolTip.Tip="{Binding DatabasePath}">
          <Image Source="/Assets/app-256.png" Width="32" Height="32" VerticalAlignment="Center"
                 RenderOptions.BitmapInterpolationMode="HighQuality" />
          <StackPanel Grid.Column="1" VerticalAlignment="Center">
            <TextBlock Text="{Binding DatabaseName}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
            <TextBlock Text="KeePassXC" Classes="muted" FontSize="12" />
          </StackPanel>
        </Grid>

        <TextBox x:Name="SearchBox" Grid.Column="1" Text="{Binding SearchText}" FontSize="18" Padding="8,10" CornerRadius="12" BorderThickness="2"
                 PlaceholderText="{x:Static res:Strings.Main_SearchPlaceholder}"
                 AutomationProperties.Name="{x:Static res:Strings.Main_SearchPlaceholder}">
          <TextBox.InnerLeftContent>
            <PathIcon Data="{StaticResource IconSearch}" Width="20" Height="20" Margin="14,0,4,0" Foreground="{DynamicResource KxcMuted}" />
          </TextBox.InnerLeftContent>
          <TextBox.InnerRightContent>
            <Border BorderBrush="{DynamicResource KxcBorder}" BorderThickness="1" CornerRadius="6" Padding="8,2" Margin="0,0,12,0"
                    VerticalAlignment="Center" IsVisible="{Binding SearchText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
              <TextBlock Text="Esc" Classes="muted" FontSize="13" />
            </Border>
          </TextBox.InnerRightContent>
        </TextBox>

        <Button Grid.Column="2" Classes="outline" Command="{Binding LockCommand}" ToolTip.Tip="Ctrl+L"
                VerticalAlignment="Stretch" VerticalContentAlignment="Center" Padding="16,0">
          <StackPanel Orientation="Horizontal" Spacing="8">
            <PathIcon Data="{StaticResource IconLock}" Width="16" Height="16" />
            <TextBlock Text="{x:Static res:Strings.Main_Lock}" />
          </StackPanel>
        </Button>
        <Button Grid.Column="3" Classes="outline" Command="{Binding OpenSettingsCommand}"
                VerticalAlignment="Stretch" VerticalContentAlignment="Center" Padding="14,0"
                ToolTip.Tip="{x:Static res:Strings.Main_Settings}" AutomationProperties.Name="{x:Static res:Strings.Settings_Title}">
          <PathIcon Data="{StaticResource IconSliders}" Width="18" Height="18" />
        </Button>
      </Grid>
    </Border>

    <!-- In basso: stato del database e dell'ultima connessione. -->
    <Border DockPanel.Dock="Bottom" Background="{DynamicResource KxcPane}" BorderBrush="{DynamicResource KxcBorder}" BorderThickness="0,1,0,0" Padding="16,8">
      <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="16">
        <StackPanel Orientation="Horizontal" Spacing="8">
          <Ellipse Width="10" Height="10" Fill="{DynamicResource KxcOk}" VerticalAlignment="Center" />
          <TextBlock Text="{Binding LockStatus}" Classes="muted" VerticalAlignment="Center" />
          <TextBlock Text="{Binding DatabaseStatus, StringFormat='· {0}'}" Classes="muted" VerticalAlignment="Center"
                     IsVisible="{Binding DatabaseStatus, Converter={x:Static ObjectConverters.IsNotNull}}" AutomationProperties.LiveSetting="Polite" />
        </StackPanel>
        <TextBlock Grid.Column="1" Text="{Binding ConnectionStatus}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                   AutomationProperties.LiveSetting="Polite" />
        <TextBlock Grid.Column="2" Text="{x:Static res:Strings.Main_Shortcuts}" Classes="muted" VerticalAlignment="Center" />
      </Grid>
    </Border>

    <Grid ColumnDefinitions="220,*,320">
      <!-- A sinistra: filtri e cartelle. -->
      <Border Background="{DynamicResource KxcPane}" BorderBrush="{DynamicResource KxcBorder}" BorderThickness="0,0,1,0">
        <ScrollViewer>
          <StackPanel Margin="10,14" Spacing="2">
            <ItemsControl ItemsSource="{Binding QuickFilters}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:FilterItemViewModel">
                  <Button Classes="filter" Classes.selected="{Binding IsSelected}"
                          Command="{Binding #Root.((vm:MainViewModel)DataContext).SelectFilterCommand}" CommandParameter="{Binding}"
                          AutomationProperties.Name="{Binding AccessibleName}">
                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                      <Panel Width="18" Height="18">
                        <PathIcon Data="{StaticResource IconList}" IsVisible="{Binding IsAllIcon}" />
                        <PathIcon Data="{StaticResource IconStarOutline}" IsVisible="{Binding IsFavoritesIcon}" />
                        <PathIcon Data="{StaticResource IconMonitor}" IsVisible="{Binding IsRdpIcon}" />
                        <PathIcon Data="{StaticResource IconTerminal}" IsVisible="{Binding IsSshIcon}" />
                        <PathIcon Data="{StaticResource IconFolder}" IsVisible="{Binding IsSftpIcon}" />
                      </Panel>
                      <TextBlock Grid.Column="1" Text="{Binding Label}" FontSize="15" VerticalAlignment="Center" />
                      <TextBlock Grid.Column="2" Text="{Binding Count}" Classes="muted" VerticalAlignment="Center" />
                    </Grid>
                  </Button>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>

            <TextBlock Text="{x:Static res:Strings.Filter_Folders}" Classes="section" Margin="12,18,0,4" />
            <ItemsControl ItemsSource="{Binding FolderFilters}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:FilterItemViewModel">
                  <Button Classes="filter" Classes.selected="{Binding IsSelected}"
                          Command="{Binding #Root.((vm:MainViewModel)DataContext).SelectFilterCommand}" CommandParameter="{Binding}"
                          AutomationProperties.Name="{Binding AccessibleName}">
                    <Grid ColumnDefinitions="*,Auto" Margin="{Binding Indent}">
                      <TextBlock Text="{Binding Label}" FontSize="15" TextTrimming="CharacterEllipsis" />
                      <TextBlock Grid.Column="1" Text="{Binding Count}" Classes="muted" />
                    </Grid>
                  </Button>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </ScrollViewer>
      </Border>

      <!-- Al centro: la lista. -->
      <Grid Grid.Column="1" RowDefinitions="Auto,*" Margin="16,8,16,0">
        <TextBlock Text="{Binding ResultsHeader}" Classes="muted" FontSize="15" Margin="12,8,0,4"
                   IsVisible="{Binding ResultsHeader, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
        <ListBox x:Name="EntryList" Grid.Row="1" Classes="entries" Background="Transparent"
                 ItemsSource="{Binding Items}" SelectedItem="{Binding SelectedItem}">
          <ListBox.ItemTemplate>
            <DataTemplate x:DataType="vm:EntryItemViewModel">
              <StackPanel>
                <TextBlock Text="{Binding SectionHeader}" IsVisible="{Binding HasSectionHeader}" Classes="section" />
                <Border Classes="row" Classes.selected="{Binding IsSelected}" AutomationProperties.Name="{Binding AccessibleName}">
                  <Grid ColumnDefinitions="Auto,Auto,*,Auto" ColumnSpacing="12">
                    <Button Classes="icon" VerticalAlignment="Center"
                            Command="{Binding #Root.((vm:MainViewModel)DataContext).ToggleFavoriteCommand}" CommandParameter="{Binding}"
                            ToolTip.Tip="{Binding FavoriteToolTip}" AutomationProperties.Name="{Binding FavoriteToolTip}">
                      <Panel Width="20" Height="20">
                        <PathIcon Data="{StaticResource IconStar}" Foreground="{DynamicResource KxcStar}" IsVisible="{Binding IsFavorite}" />
                        <PathIcon Data="{StaticResource IconStarOutline}" Foreground="{DynamicResource KxcMuted}" IsVisible="{Binding !IsFavorite}" />
                      </Panel>
                    </Button>
                    <Panel Grid.Column="1" Width="44" Height="44" VerticalAlignment="Center">
                      <Border CornerRadius="10" Background="{DynamicResource KxcRdpSoft}" IsVisible="{Binding IsRdp}">
                        <PathIcon Data="{StaticResource IconMonitor}" Width="22" Height="22" Foreground="{DynamicResource KxcRdpFg}" />
                      </Border>
                      <Border CornerRadius="10" Background="{DynamicResource KxcSshSoft}" IsVisible="{Binding IsSsh}">
                        <PathIcon Data="{StaticResource IconTerminal}" Width="22" Height="22" Foreground="{DynamicResource KxcSshFg}" />
                      </Border>
                      <Border CornerRadius="10" Background="{DynamicResource KxcSftpSoft}" IsVisible="{Binding IsSftp}">
                        <PathIcon Data="{StaticResource IconFolder}" Width="22" Height="22" Foreground="{DynamicResource KxcSftpFg}" />
                      </Border>
                    </Panel>
                    <StackPanel Grid.Column="2" VerticalAlignment="Center" Spacing="2">
                      <TextBlock Text="{Binding DisplayTitle}" FontSize="16" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                      <TextBlock Text="{Binding HostDisplay}" Classes="mono muted" FontSize="14" TextTrimming="CharacterEllipsis" />
                      <StackPanel Orientation="Horizontal" Spacing="6" IsVisible="{Binding HasWarning}">
                        <PathIcon Data="{StaticResource IconWarning}" Width="14" Height="14" Foreground="{DynamicResource KxcWarning}" />
                        <TextBlock Text="{Binding WarningText}" Classes="warning" FontSize="13" TextWrapping="Wrap" />
                      </StackPanel>
                    </StackPanel>
                    <ItemsControl Grid.Column="3" ItemsSource="{Binding Protocols}" VerticalAlignment="Center">
                      <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                          <StackPanel Orientation="Horizontal" Spacing="8" />
                        </ItemsPanelTemplate>
                      </ItemsControl.ItemsPanel>
                      <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:ProtocolButtonViewModel">
                          <Button Classes="outline" Classes.primary="{Binding Owner.IsSelected}" Padding="14,8"
                                  IsEnabled="{Binding CanConnect}"
                                  Command="{Binding #Root.((vm:MainViewModel)DataContext).ConnectProtocolCommand}" CommandParameter="{Binding}"
                                  AutomationProperties.Name="{Binding AccessibleName}">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                              <TextBlock Text="{Binding Label}" Foreground="{Binding $parent[Button].Foreground}" FontWeight="SemiBold" />
                              <PathIcon Data="{StaticResource IconArrowRight}" Width="14" Height="14"
                                        Foreground="{Binding $parent[Button].Foreground}" />
                            </StackPanel>
                          </Button>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </Grid>
                </Border>
              </StackPanel>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
        <TextBlock Grid.Row="1" Text="{Binding EmptyMessage}" Classes="muted" FontSize="15" TextWrapping="Wrap"
                   MaxWidth="420" HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center"
                   IsVisible="{Binding EmptyMessage, Converter={x:Static ObjectConverters.IsNotNull}}" />
      </Grid>

      <!-- A destra: dettaglio della voce selezionata, senza password. -->
      <Border Grid.Column="2" Background="{DynamicResource KxcPane}" BorderBrush="{DynamicResource KxcBorder}" BorderThickness="1,0,0,0">
        <ScrollViewer>
          <ContentControl Content="{Binding Detail}" Margin="24">
            <ContentControl.ContentTemplate>
              <DataTemplate x:DataType="vm:EntryDetailViewModel">
                <StackPanel Spacing="14">
                  <Grid ColumnDefinitions="Auto,*" ColumnSpacing="14">
                    <Panel Width="52" Height="52">
                      <Border CornerRadius="12" Background="{DynamicResource KxcRdpSoft}" IsVisible="{Binding IsRdp}">
                        <PathIcon Data="{StaticResource IconMonitor}" Width="24" Height="24" Foreground="{DynamicResource KxcRdpFg}" />
                      </Border>
                      <Border CornerRadius="12" Background="{DynamicResource KxcSshSoft}" IsVisible="{Binding IsSsh}">
                        <PathIcon Data="{StaticResource IconTerminal}" Width="24" Height="24" Foreground="{DynamicResource KxcSshFg}" />
                      </Border>
                      <Border CornerRadius="12" Background="{DynamicResource KxcSftpSoft}" IsVisible="{Binding IsSftp}">
                        <PathIcon Data="{StaticResource IconFolder}" Width="24" Height="24" Foreground="{DynamicResource KxcSftpFg}" />
                      </Border>
                    </Panel>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                      <TextBlock Text="{Binding Title}" FontSize="22" FontWeight="SemiBold" TextWrapping="Wrap" />
                      <TextBlock Text="{Binding FolderPath}" Classes="muted" TextWrapping="Wrap" />
                    </StackPanel>
                  </Grid>

                  <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto" RowSpacing="12" ColumnSpacing="16" Margin="0,8,0,0">
                    <TextBlock Text="{x:Static res:Strings.Detail_Protocol}" Classes="muted" />
                    <TextBlock Grid.Column="1" Text="{Binding ProtocolLabel}" FontWeight="SemiBold" Foreground="{DynamicResource KxcAccentText}" HorizontalAlignment="Right" />
                    <TextBlock Grid.Row="1" Text="{x:Static res:Strings.Detail_Host}" Classes="muted" />
                    <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding Host}" Classes="mono" HorizontalAlignment="Right" TextTrimming="CharacterEllipsis" />
                    <TextBlock Grid.Row="2" Text="{x:Static res:Strings.Detail_Port}" Classes="muted" />
                    <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding Port}" Classes="mono" HorizontalAlignment="Right" />
                    <TextBlock Grid.Row="3" Text="{x:Static res:Strings.Detail_User}" Classes="muted" />
                    <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding User}" Classes="mono" HorizontalAlignment="Right" TextTrimming="CharacterEllipsis" />
                    <TextBlock Grid.Row="4" Text="{x:Static res:Strings.Detail_Domain}" Classes="muted" IsVisible="{Binding HasDomain}" />
                    <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding Domain}" Classes="mono" HorizontalAlignment="Right" IsVisible="{Binding HasDomain}" />
                    <TextBlock Grid.Row="5" Text="{x:Static res:Strings.Detail_LastConnection}" Classes="muted" />
                    <TextBlock Grid.Row="5" Grid.Column="1" Text="{Binding LastConnection}" HorizontalAlignment="Right" />
                  </Grid>

                  <TextBlock Text="{x:Static res:Strings.Detail_SshKey}" Classes="muted" IsVisible="{Binding UsesSshAgent}" TextWrapping="Wrap" />
                  <TextBlock Text="{Binding Item.WarningText}" Classes="warning" IsVisible="{Binding Item.HasWarning}" TextWrapping="Wrap" />

                  <!-- Un pulsante per protocollo, come nella lista: stesso nome e stessa azione. -->
                  <ItemsControl ItemsSource="{Binding Item.Protocols}" Margin="0,8,0,0">
                    <ItemsControl.ItemsPanel>
                      <ItemsPanelTemplate>
                        <UniformGrid Rows="1" ColumnSpacing="10" />
                      </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="vm:ProtocolButtonViewModel">
                        <Button Classes="primary" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Padding="12,14"
                                IsEnabled="{Binding CanConnect}"
                                Command="{Binding #Root.((vm:MainViewModel)DataContext).ConnectProtocolCommand}" CommandParameter="{Binding}"
                                AutomationProperties.Name="{Binding AccessibleName}">
                          <StackPanel Orientation="Horizontal" Spacing="10">
                            <TextBlock Text="{Binding Label}" FontSize="17" FontWeight="SemiBold" Foreground="{DynamicResource KxcOnAccent}" />
                            <PathIcon Data="{StaticResource IconArrowRight}" Width="16" Height="16" Foreground="{DynamicResource KxcOnAccent}" />
                          </StackPanel>
                        </Button>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                  <TextBlock Text="{x:Static res:Strings.Detail_PasswordNote}" Classes="muted" TextWrapping="Wrap" />
                </StackPanel>
              </DataTemplate>
            </ContentControl.ContentTemplate>
          </ContentControl>
        </ScrollViewer>
      </Border>
    </Grid>
  </DockPanel>
</UserControl>
